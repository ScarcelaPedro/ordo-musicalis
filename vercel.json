{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/lembretes", "schedule": "0 12 * * *" },
    { "path": "/api/cron/liturgia-sync", "schedule": "0 6 * * *" }
  ]
}
