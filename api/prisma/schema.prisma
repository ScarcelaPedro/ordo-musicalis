generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  coordenador
  musico
}

enum ScaleStatus {
  rascunho
  confirmada
}

enum AvailabilityType {
  data_especifica
  recorrente_semanal
}

enum Period {
  manha
  tarde
  noite
}

enum NivelServidor {
  em_formacao
  apto
  lider
}

enum RecurrenceType {
  semanal
  mensal_ordinal
}

enum StatusEscalacao {
  convidado
  confirmado
  recusado
  substituido
}

enum SubstituicaoStatus {
  pendente
  aprovada
  rejeitada
}

enum OrigemEscalacao {
  fixo
  provisorio
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  emailVerifiedAt   DateTime? @map("email_verified_at")
  password          String
  role              UserRole  @default(musico)
  passwordResetToken String?  @map("password_reset_token")
  passwordResetAt   DateTime? @map("password_reset_at")
  rememberToken     String?   @map("remember_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  servidor Servidor?
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Servidor {
  id          Int           @id @default(autoincrement())
  userId      Int?          @unique @map("user_id")
  nome        String
  telefone    String?
  email       String?
  ativo       Boolean       @default(true)
  nivel       NivelServidor @default(apto)
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  instruments   InstrumentServidor[]
  teams         ServidorMinisterio[]
  categorias    ServidorCategoria[]
  availabilities Availability[]
  scales        ScaleServidor[]
  teamsResponsavel Team[]            @relation("TeamResponsavel")
  vinculosFixos VinculoFixo[]
  windowResponses AvailabilityWindowResponse[]
  substituicoesComoSubstituto Substituicao[] @relation("SubstitutoMusico")

  @@map("servidores")
}

model Celebrante {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String?
  email       String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  celebracoes Scale[]

  @@map("celebrantes")
}

model Instrument {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  servidores InstrumentServidor[]
  scales     ScaleServidor[]
  vinculosFixos VinculoFixo[]

  @@map("instruments")
}

model InstrumentServidor {
  id           Int @id @default(autoincrement())
  instrumentId Int @map("instrument_id")
  servidorId   Int @map("servidor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  servidor   Servidor   @relation(fields: [servidorId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, servidorId])
  @@map("instrument_servidor")
}

model Comunidade {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scales Scale[]

  @@map("comunidades")
}

model CategoriaFuncao {
  id        Int      @id @default(autoincrement())
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams      Team[]
  servidores ServidorCategoria[]
  escalacoes ScaleServidor[]

  @@map("categorias_funcao")
}

model ServidorCategoria {
  id          Int      @id @default(autoincrement())
  servidorId  Int      @map("servidor_id")
  categoriaId Int      @map("categoria_id")
  createdAt   DateTime @default(now()) @map("created_at")

  servidor  Servidor        @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  categoria CategoriaFuncao @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([servidorId, categoriaId])
  @@map("servidor_categoria")
}

model Team {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String?
  ativo         Boolean  @default(true)
  responsavelId Int?     @map("responsavel_id")
  categoriaId   Int      @map("categoria_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  responsavel Servidor? @relation("TeamResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  categoria   CategoriaFuncao @relation(fields: [categoriaId], references: [id])
  servidores  ServidorMinisterio[]
  scales      Scale[]
  scaleTemplates ScaleTemplate[]
  escalacoes  ScaleServidor[]

  @@map("teams")
}

model ServidorMinisterio {
  id         Int @id @default(autoincrement())
  servidorId Int @map("servidor_id")
  teamId     Int @map("team_id")
  funcao     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  servidor Servidor @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([servidorId, teamId])
  @@map("servidor_ministerio")
}

model Scale {
  id          Int         @id @default(autoincrement())
  dataCelebracao DateTime @map("data_celebracao") @db.Date
  horario     String
  celebracao  String
  teamId      Int?        @map("team_id")
  comunidadeId Int        @map("comunidade_id")
  celebranteId Int?       @map("celebrante_id")
  observacoes String?
  status      ScaleStatus @default(rascunho)
  lembreteDiasAntes Int   @default(3) @map("lembrete_dias_antes")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  team       Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  comunidade Comunidade     @relation(fields: [comunidadeId], references: [id])
  celebrante Celebrante?    @relation(fields: [celebranteId], references: [id], onDelete: SetNull)
  servidores ScaleServidor[]
  repertoire Repertoire?

  @@map("scales")
}

model ScaleServidor {
  id           Int             @id @default(autoincrement())
  scaleId      Int             @map("scale_id")
  servidorId   Int             @map("servidor_id")
  instrumentId Int?            @map("instrument_id")
  teamId       Int?            @map("team_id")
  categoriaId  Int?            @map("categoria_id")
  status       StatusEscalacao @default(convidado)
  origem       OrigemEscalacao @default(provisorio)
  lembreteEnviadoEm DateTime?  @map("lembrete_enviado_em")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  scale         Scale           @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  servidor      Servidor        @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  instrument    Instrument?     @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  team          Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  categoria     CategoriaFuncao? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  substituicoes Substituicao[]

  @@unique([scaleId, servidorId])
  @@map("scale_servidor")
}

model Substituicao {
  id              Int                @id @default(autoincrement())
  scaleServidorId Int                @map("scale_servidor_id")
  substitutoId    Int?               @map("substituto_id")
  motivo          String?
  status          SubstituicaoStatus @default(pendente)
  createdAt       DateTime           @default(now()) @map("created_at")
  decidedAt       DateTime?          @map("decided_at")

  scaleServidor ScaleServidor @relation(fields: [scaleServidorId], references: [id], onDelete: Cascade)
  substituto    Servidor?     @relation("SubstitutoMusico", fields: [substitutoId], references: [id], onDelete: SetNull)

  @@map("substituicoes")
}

model Repertoire {
  id          Int      @id @default(autoincrement())
  scaleId     Int      @unique @map("scale_id")
  titulo      String
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  scale Scale           @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  items RepertoireItem[]

  @@map("repertoires")
}

model RepertoireItem {
  id             Int      @id @default(autoincrement())
  repertoireId   Int      @map("repertoire_id")
  ordem          Int      @default(0)
  tituloMusica   String   @map("titulo_musica")
  tom            String?
  arquivoPdfPath String?  @map("arquivo_pdf_path")
  linkExterno    String?  @map("link_externo")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  repertoire Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@map("repertoire_items")
}

model Availability {
  id          Int              @id @default(autoincrement())
  servidorId  Int              @map("servidor_id")
  tipo        AvailabilityType
  diaSemana   Int?             @map("dia_semana") @db.SmallInt
  data        DateTime?        @db.Date
  periodo     Period
  disponivel  Boolean          @default(true)
  observacao  String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  servidor Servidor @relation(fields: [servidorId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model ScaleTemplate {
  id              Int            @id @default(autoincrement())
  celebracao      String
  horario         String
  diaSemana       Int            @map("dia_semana") @db.SmallInt
  tipoRecorrencia RecurrenceType @default(semanal) @map("tipo_recorrencia")
  ordinal         Int?           @db.SmallInt
  teamId          Int?           @map("team_id")
  observacoes     String?
  ativo           Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  vinculosFixos VinculoFixo[]

  @@map("scale_templates")
}

model VinculoFixo {
  id              Int      @id @default(autoincrement())
  servidorId      Int      @map("servidor_id")
  instrumentId    Int?     @map("instrument_id")
  scaleTemplateId Int      @map("scale_template_id")
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  servidor      Servidor      @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  instrument    Instrument?   @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  scaleTemplate ScaleTemplate @relation(fields: [scaleTemplateId], references: [id], onDelete: Cascade)

  @@unique([servidorId, scaleTemplateId])
  @@map("vinculos_fixos")
}

model AvailabilityWindow {
  id        Int      @id @default(autoincrement())
  mes       String
  prazo     DateTime
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  responses AvailabilityWindowResponse[]

  @@unique([mes])
  @@map("availability_windows")
}

model AvailabilityWindowResponse {
  id          Int      @id @default(autoincrement())
  windowId    Int      @map("window_id")
  servidorId  Int      @map("servidor_id")
  respondedAt DateTime @default(now()) @map("responded_at")

  window   AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  servidor Servidor           @relation(fields: [servidorId], references: [id], onDelete: Cascade)

  @@unique([windowId, servidorId])
  @@map("availability_window_responses")
}
